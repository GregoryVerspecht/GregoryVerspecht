---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
---

<!doctype html>
<html lang="en">
  <Header title="Contact | Gregory Verspecht" />
  <body>
    <div class="content">
      <Sidebar selectedItem="contact" />

      <nav class="main">
        <div class="container">
          <!-- Back navigation -->
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block">
              <img
                src="/assets/back.svg"
                loading="lazy"
                alt="Back"
                class="back-nav-img"
              />
              <div>Back</div>
            </a>
          </div>

          <!-- Page content -->
          <div class="content-container">
<!-- FORM -->

            <form
              action="https://formspree.io/f/mzdvnlwq"
              method="POST"
              class="fs-form"
            >
              <header class="fs-header">
                <h2>Get in touch</h2>
                <p>
                  Have a question, idea, or just want to say hi?<br />
                  Leave a message and I’ll get back to you.
                </p>
              </header>

              <div class="fs-field">
                <label for="name">Name</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Your name"
                  required
                />
              </div>

              <div class="fs-field">
                <label for="email">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="you@example.com"
                  required
                />
              </div>

              <div class="fs-field">
                <label>Reason for contacting</label>
                <select name="reason" required>
                  <option value="">Select a reason</option>
                  <option>Job opportunity</option>
                  <option>General question</option>
                  <option>Technical discussion</option>
                  <option>Collaboration / project</option>
                  <option>Other</option>
                </select>
              </div>

              <div class="fs-field">
                <label for="message">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Your message"></textarea>
              </div>

              <!-- Honeypot -->
              <input type="text" name="_gotcha" hidden />

              <button type="submit" class="fs-button"> Send message </button>
            </form>
            <!-- Contact options -->
            <div class="contact-actions">
              <a
                href="https://www.linkedin.com/in/gregoryverspecht/"
                target="_blank"
                rel="noopener"
                class="contact-link"
              >
                <img
                  src="/assets/linkedin-svgrepo-com.svg"
                  width="25%"
                  height="25%"
                  alt="LinkedIn"
                  class="contact-icon"
                />
                Connect on LinkedIn
              </a>
            </div>

          </div>
        </div>
      </nav>
    </div>
  </body>
</html>
