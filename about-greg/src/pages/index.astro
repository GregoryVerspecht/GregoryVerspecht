---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <Header title="Gregory Verspecht" />
  <body>
    <div class="content">
      <div class="main">
        <div class="container">
          <main class="hero hero--stack hero--center">
            <div class="hero__media">
              <img
                src="/assets/gregory.jpg"
                alt="Gregory Verspecht"
                loading="eager"
                class="hero__avatar"
              />
            </div>

            <div class="hero__content">
              <h1>Hi, I'm Gregory.</h1>
              <h3>OT System Engineer passionate about bridging OT and IT.</h3>
              <p class="lead">
                Focused on integrating OT environments with IT infrastructure
                while respecting industrial constraints, uptime requirements and
                operational safety.
              </p>
            </div>

            <a href="#contact" class="hero__cta button w-button">
              Get in touch!
            </a>
          </main>

          <section id="contact" class="content-container">
            <form
              action="https://formspree.io/f/mzdvnlwq"
              method="POST"
              class="fs-form"
            >
              <header class="fs-header">
                <h2>Get in touch</h2>
                <p>
                  Have a question, idea, or just want to say hi?<br />
                  Leave a message and I’ll get back to you.
                </p>
              </header>

              <div class="fs-field">
                <label for="name">Name</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Your name"
                  required
                />
              </div>

              <div class="fs-field">
                <label for="email">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="you@example.com"
                  required
                />
              </div>

              <div class="fs-field">
                <label for="reason">Reason for contacting</label>
                <select id="reason" name="reason" required>
                  <option value="">Select a reason</option>
                  <option>Job opportunity</option>
                  <option>General question</option>
                  <option>Technical discussion</option>
                  <option>Collaboration / project</option>
                  <option>Other</option>
                </select>
              </div>

              <div class="fs-field">
                <label for="message">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Your message"></textarea>
              </div>

              <!-- Honeypot -->
              <input type="text" name="_gotcha" hidden />

              <button type="submit" class="fs-button"> Send message </button>
            </form>

            <div class="contact-actions">
              <a
                href="https://www.linkedin.com/in/gregoryverspecht/"
                target="_blank"
                rel="noopener"
                class="contact-link"
              >
                <img
                  src="/assets/linkedin-svgrepo-com.svg"
                  width="25%"
                  height="25%"
                  alt="LinkedIn"
                  class="contact-icon"
                />
                Connect on LinkedIn
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </body>
</html>
