---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
---

<!doctype html>
<html>
  <Header title="Gregory Verspecht" />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="hero hero--stack hero--center">
            <a href="/" class="hero__media" aria-label="home">
              <img
                src="/assets/gregory.jpg"
                alt="Profile picture"
                loading="eager"
                class="hero__avatar"
              />
            </a>

            <div class="hero__content">
              <h1>Hi, I'm Gregory.<br /></h1>
              <h3>OT System Engineer passionate about bridging OT and IT.</h2>
              <p class="lead">
                Focused on integrating OT environments with IT infrastructure
                while respecting industrial constraints, uptime requirements and
                operational safety.
              </p>
            </div>

            <a
              href="mailto:gregory.verspecht@gmail.com"
              class="hero__cta button w-button"
            >
              Contact
            </a>

</main>
        </div>

        <div class="projects-section">
          <!-- Software Development -->
          <a href="/software-development" class="projects-container">
            <div class="single-projects-category">
              <div class="projects-category-image-container">
                <img
                  src="./assets/browser.svg"
                  loading="lazy"
                  alt=""
                  class="projects-category-image"
                />
              </div>
            </div>
            <div class="single-projects-content">
              <h4>Software Development</h4>
              <div class="tech-tools-container">
                <div class="mini-label-white gray-color">
                  Technologies &amp; tools
                </div>
                <div class="chips-container chips-container-small-width">
                  <div class="single-chip small-chip">React</div>
                  <div class="single-chip small-chip">Next.js</div>
                  <div class="single-chip small-chip">Node.js</div>
                  <div class="single-chip small-chip">MongoDB</div>
                  <div class="single-chip small-chip">Heroku</div>
                  <div class="single-chip small-chip">RabbitMQ</div>
                  <div class="single-chip small-chip">Express.js</div>
                  <div class="single-chip small-chip">TypeScript</div>
                  <div class="single-chip small-chip">NestJS</div>
                  <div class="single-chip small-chip">Angular</div>
                  <div class="single-chip small-chip">Postgres</div>
                  <div class="single-chip small-chip">Linode</div>
                </div>
              </div>
            </div>
          </a>
          <!-- DevOps & Cloud -->
          <a href="/devops" class="projects-container">
            <div class="single-projects-category">
              <div class="projects-category-image-container devops-img">
                <img
                  src="./assets/database.svg"
                  loading="lazy"
                  alt=""
                  class="projects-category-image"
                />
              </div>
            </div>
            <div class="single-projects-content">
              <h4>DevOps &amp;&nbsp;Cloud</h4>
              <div class="tech-tools-container">
                <div class="mini-label-white gray-color">
                  Technologies &amp; tools
                </div>
                <div class="chips-container chips-container-small-width">
                  <div class="single-chip small-chip">Terraform</div>
                  <div class="single-chip small-chip">Azure</div>
                  <div class="single-chip small-chip">AWS</div>
                  <div class="single-chip small-chip">Docker</div>
                  <div class="single-chip small-chip">Kubernetes</div>
                  <div class="single-chip small-chip">GitLab CI/CD</div>
                  <div class="single-chip small-chip">RKE</div>
                  <div class="single-chip small-chip">Node.js</div>
                  <div class="single-chip small-chip">RabbitMQ</div>
                  <div class="single-chip small-chip">Linux</div>
                  <div class="single-chip small-chip">Bash</div>
                  <div class="single-chip small-chip">Grafana</div>
                  <div class="single-chip small-chip">Prometheus</div>
                </div>
              </div>
            </div>
          </a>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
