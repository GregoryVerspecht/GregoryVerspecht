---
const title = "Gregory Verspecht";
const description = "Gregory Verspecht – OT System Engineer bridging OT and IT.";
const linkedin = "https://www.linkedin.com/in/gregoryverspecht/";
const projects = [
  {
    title: "SeshScore",
    desc: "A free score tracker for card games, board games, darts and more. Built-in game presets, round tracking and undo. No account needed, works offline.",
    tech: ["PWA", "Capacitor", "iOS App Store"],
    url: "https://seshscore.gv-tech.eu",
  },
  {
    title: "Pong Cup",
    desc: "A beerpong tournament tracker: group stage to knockout, live scoring on multiple tables, timers, player stats, a TV mode and sync across devices.",
    tech: ["HTML & JavaScript", "Supabase", "Capacitor"],
    url: "https://pong-cup.gv-tech.eu",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/jpeg" href="/assets/gregory.jpg" />
    <link rel="apple-touch-icon" href="/assets/gregory.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <div class="mono-label">gv-tech.eu</div>
        <a href={linkedin} target="_blank" rel="noopener" class="topbar__link">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
          <span>LinkedIn</span>
        </a>
      </header>

      <main class="hero">
        <img
          src="/assets/gregory.jpg"
          alt="Gregory Verspecht"
          loading="eager"
          class="hero__avatar"
        />
        <div class="hero__content">
          <div class="mono-label mono-label--accent">OT System Engineer</div>
          <h1>Hi, I'm Gregory.</h1>
          <p class="hero__tagline">Passionate about bridging OT and IT.</p>
          <p class="hero__lead">
            Focused on integrating OT environments with IT infrastructure while
            respecting industrial constraints, uptime requirements and
            operational safety.
          </p>
        </div>
      </main>

      <section class="projects">
        <div class="section-heading">
          <h2 class="mono-label">Side projects</h2>
          <div class="section-heading__rule"></div>
        </div>
        <div class="projects__grid">
          {
            projects.map((project) => (
              <article class="card">
                <h3>{project.title}</h3>
                <p>{project.desc}</p>
                <div class="chips">
                  {project.tech.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener"
                  class="card__link"
                >
                  <span>{new URL(project.url).host}</span>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <footer class="footer">
        <span>Gregory Verspecht</span>
        <span>OT / IT</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --ground: #0b1114;
    --panel: #111a1f;
    --line: #22313a;
    --text: #e6eef2;
    --text-soft: #9db0ba;
    --muted: #8fa3ae;
    --accent: #f5a524;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--ground);
  }

  body {
    margin: 0;
    min-height: 100vh;
    padding: clamp(24px, 4vw, 48px) clamp(20px, 5vw, 64px);
    background: var(--ground);
    color: var(--text);
    font-family: "IBM Plex Sans", system-ui, sans-serif;
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    color: #fff;
  }

  .page {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 7vw, 88px);
  }

  .mono-label {
    margin: 0;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mono-label--accent {
    color: var(--accent);
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .topbar__link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 14px;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .hero__avatar {
    width: clamp(140px, 22vw, 240px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--line);
    display: block;
  }

  .hero__content {
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h1 {
    margin: 0;
    font-size: clamp(40px, 6.4vw, 76px);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -1px;
  }

  .hero__tagline {
    margin: 0;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.35;
  }

  .hero__lead {
    margin: 0;
    max-width: 600px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-soft);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .section-heading__rule {
    flex-grow: 1;
    height: 1px;
    background: var(--line);
  }

  .projects__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .card {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .card h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 500;
  }

  .card p {
    margin: 0;
    flex-grow: 1;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: #c3d0d7;
  }

  .chip {
    padding: 4px 10px;
    border: 1px solid #2c3e49;
    border-radius: 6px;
  }

  .card__link {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--accent);
  }

  .card__link:hover {
    color: #ffc266;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
</style>
