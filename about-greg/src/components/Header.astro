---
interface HeaderProps {
  title: string;
}
const { title } = Astro.props as HeaderProps;
const description = "Gregory Verspecht – OT System Engineer bridging OT and IT.";
---

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>{title}</title>
  <meta content={description} name="description" />
  <meta content={title} property="og:title" />
  <meta content={description} property="og:description" />
  <meta content={title} property="twitter:title" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <link href="/assets/styles.css" rel="stylesheet" type="text/css" />
  <link href="/assets/gregory.jpg" rel="icon" type="image/jpeg" />
  <link href="/assets/gregory.jpg" rel="apple-touch-icon" />
</head>
